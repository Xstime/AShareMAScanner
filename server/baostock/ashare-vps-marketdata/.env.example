# Storage and read-only API
ASHARE_DATA_DIR=/var/lib/ashare-marketdata
ASHARE_API_HOST=127.0.0.1
ASHARE_API_PORT=8765
# Set this to the public HTTPS base URL after configuring your reverse proxy.
# Example: https://your-domain.example/marketdata
ASHARE_PUBLIC_BASE_URL=

# Market data policy
ASHARE_HISTORY_DAYS=120
ASHARE_RETENTION_DAYS=120
ASHARE_BATCH_SIZE=200
ASHARE_BATCH_PAUSE=2.0
ASHARE_MAX_CONSECUTIVE_ERRORS=25
# Stay below BaoStock's documented daily request ceiling.
ASHARE_MAX_API_REQUESTS_PER_DAY=45000
ASHARE_RETRY_BASE_HOURS=6
ASHARE_RETRY_MAX_HOURS=168
ASHARE_INDUSTRY_REFRESH_DAYS=7
ASHARE_MIN_PUBLISH_COMPLETENESS=0.995
ASHARE_LOG_LEVEL=INFO
